# Build output — large, regenerated, never reviewed.
app/ios/build/
*.xcarchive/
*.ipa

# Local PocketBase data and binary. The binary is fetched per machine; pb_data
# holds a real database and must never be committed.
backend/pb_data/
backend/pocketbase
backend/pb.zip
backend/pb.log
pb_data/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets — never commit. See the handoff for where the real ones live.
.env
.env.*
*.env
!.env.example

# Editor / OS noise
.DS_Store

# Disposable verification rigs and local build products.
/work/

# local speaker-recognition models + the owner's voice profile — never in git
.speaker-models/

# Chrome for Testing, when it lands in the repo instead of the cache.
# `npx @puppeteer/browsers install chrome@stable` defaults to the CURRENT
# DIRECTORY, so run from the repo root it drops a 356MB browser here and
# `git add -A` cheerfully commits 348 files of app bundle (done once,
# 2026-08-24, and reverted). proof/chrome_arm.mjs:157 only ever looks in
# ~/.cache/puppeteer/chrome, so pass `--path "$HOME/.cache/puppeteer"` and
# a copy in here is waste either way. chrome/.metadata stays tracked.
/chrome/mac_arm-*/
/chrome/linux-*/
/chrome/mac-*/
/chrome/win*-*/

# Xcode per-user window/scheme state. Machine-local, changes on every
# open, and belongs to whoever opened the project rather than to the app.
xcuserdata/
