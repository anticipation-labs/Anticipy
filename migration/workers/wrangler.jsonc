{
  // ==========================================================================
  // migration/workers/wrangler.jsonc — the API Worker.
  //
  // This is a SECOND Worker, separate from the website's. The repo root already
  // holds `wrangler.jsonc` for `anticipy-site` (OpenNext, .open-next/worker.js),
  // and the two must stay separate for three reasons:
  //   1. The site is redeployed on every marketing copy change. The backend is
  //      the safety system. They must not share a deploy blast radius.
  //   2. The site does not need D1, R2 or a Durable Object binding, and a
  //      binding it does not need is an escalation path it does not need.
  //   3. Bundle ceiling. The site measured 2.63 MB gzipped against the free
  //      plan's 3 MB (migration/spike/website-verification.md); adding bcryptjs
  //      and this router to that bundle spends headroom that is already at 88%.
  //
  // Deploy:  wrangler deploy --config migration/workers/wrangler.jsonc
  // ==========================================================================
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anticipy-api",
  // api.anticipy.ai routes to this Worker (the iOS app + future backend origin).
  "routes": [
    { "pattern": "api.anticipy.ai", "custom_domain": true },
    // THE CONNECT PAGE ON THE APEX, and it is not cosmetic.
    //
    // A person receives this link in a text message. The spec's first rule is
    // that they never see the plumbing — "connect your Notion", our name, our
    // domain — and `api.anticipy.ai/c/xxx` reads as somebody's backend, which
    // is exactly the tell the rule exists to avoid.
    //
    // It is also load-bearing rather than taste: ConnectHandoff.swift on the
    // phone keeps an EXACT-host allowlist, `["anticipy.ai"]`, so a link minted
    // on api.anticipy.ai is refused by the app that asked for it — measured,
    // and already pinned by name in ConnectedAppsClientTests. One of the two
    // had to move, and the apex is the one the product wants.
    //
    // More specific than any `anticipy.ai/*` route, so it wins for /c/ only and
    // leaves the website serving everything else.
    { "pattern": "anticipy.ai/c/*", "zone_name": "anticipy.ai" }
  ],
  // Consolidated here by decision 2026-09-04. The DMG bucket that ship.sh
  // writes still lives on account 5b63e25e and has to be copied across.
  "account_id": "114587b715e702461766369b01d42fc7",
  "main": "src/index.ts",

  // DECLARED EXPLICITLY, and it is not cosmetic.
  //
  // With this absent, four consecutive `wrangler deploy` runs reported success
  // and promoted a version to 100% while anticipy-api.omar-114.workers.dev
  // kept serving an OLDER build -- health said channels:false with the secrets
  // demonstrably bound, and /internal/assistant answered with a catch-all that
  // no longer exists in the source. `wrangler dev --remote` on the same commit
  // was correct, which is what proved the code was fine and the ROUTE was not.
  //
  // This is the same shape as the deploy rule in CLAUDE.md: the tool reports
  // success while the thing users reach does not change. Verify a deploy by
  // asking the live URL what it is, never by reading the exit code.
  "workers_dev": true,
  "compatibility_date": "2026-09-03",

  // REQUIRED, not optional: bcryptjs reaches for node built-ins.
  // migration/spike/bcrypt-on-workerd.md ran with exactly this flag set and
  // verified both $2a$ and $2b$ digests against the production cost factor.
  "compatibility_flags": ["nodejs_compat"],

  // --------------------------------------------------------------------------
  // CPU. THE LOGIN PATH DOES NOT FIT THE DEFAULT-BY-ACCIDENT.
  //
  // bcrypt at cost factor 10 measured ~50 ms of CPU per verify on workerd
  // (spike/bcrypt-on-workerd.md). The FREE plan caps CPU at 10 ms per request,
  // so on free every login fails with an exceeded-CPU error — not slowly, every
  // time. Workers Paid is a precondition, and this is stated in
  // migration/BLOCKERS.md as one of the four things one upgrade unblocks.
  //
  // 200 ms is chosen to hold one bcrypt verify plus the dummy-hash compare on
  // the no-such-account path, with room. Raising it does not cost money on its
  // own — Workers Paid bills CPU actually used — but a low ceiling turns a slow
  // request into an error, which is the failure mode worth avoiding.
  // --------------------------------------------------------------------------
  "limits": { "cpu_ms": 200 },

  "observability": { "enabled": true },

  // --------------------------------------------------------------------------
  // D1
  // Schema: migration/d1/schema.sql (26 tables, 46 indexes, 5 partial-unique).
  // Applied and verified on `anticipy-backend-staging` (migration/BLOCKERS.md).
  // --------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anticipy-backend",
      "database_id": "f341f23d-ec52-4b2f-9a2d-13117ebee86e"
    }
  ],

  // --------------------------------------------------------------------------
  // R2 — evidence photos ONLY.
  //
  // NOT a public bucket and NOT given a custom domain. evidence.pb.js:56-147
  // exists so the bytes are reachable only through a gate that checks the share
  // window and spends a 5-fetch ceiling; a public R2 URL is that gate deleted.
  // Twilio fetches these by MediaUrl from its own infrastructure, so the URL
  // handed out must be this Worker's /api/files/... and never the bucket's.
  //
  // The backups bucket `anticipy-pocketbase-backups-production` is NOT bound
  // here. It is written by PocketBase's own scheduled backup
  // (1700000053_off_volume_backups.js) and nothing in this Worker should be
  // able to touch it. See migration/BLOCKERS.md — R2 is not enabled on this
  // account, so those backups are going somewhere else or failing, and that is
  // an open question before anything is decommissioned.
  // --------------------------------------------------------------------------
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "anticipy-evidence" }
  ],

  // --------------------------------------------------------------------------
  // Durable Object — the pair-code guess ceiling.
  // Replaces e.app.store() (guard.pb.js:116-195), which a Worker has no
  // equivalent of: a module-level Map is per-isolate, and KV is eventually
  // consistent, so both let a distributed guesser mint fresh counters.
  // src/do/PairCodeCounter.ts explains it at length.
  // --------------------------------------------------------------------------
  "durable_objects": {
    "bindings": [
      { "name": "PAIR_CODE_COUNTER", "class_name": "PairCodeCounter" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed DO classes. UNVERIFIED whether `new_sqlite_classes` is
      // required vs `new_classes` for this account/compat date — check
      // `wrangler deploy --dry-run` output before the first real deploy; the
      // wrong one is a deploy-time error, not a runtime surprise.
      "new_sqlite_classes": ["PairCodeCounter"]
    }
  ],

  // --------------------------------------------------------------------------
  // Static assets — pb_public/, verbatim.
  // Populate migration/workers/public/ from backend/pb_public/ at build time
  // (`npm run stage:assets`, ARCHITECTURE.md §10) rather than committing a
  // second copy of 1.3 MB of zips.
  //
  // run_worker_first is FALSE for these paths: they need no auth and no
  // counting, so serving them from the edge without invoking the Worker is
  // both cheaper and one fewer place to get authorization wrong.
  // --------------------------------------------------------------------------
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // PocketBase served /internal.html AT /internal.html. Workers Static Assets
    // defaults to html_handling "auto-trailing-slash", which 307s /internal.html
    // to /internal -- and the website rewrites /internal to THIS backend's
    // /internal.html (next.config.mjs), so the default would bounce HQ between
    // the two. "none" serves the path asked for, which is what the callers and
    // the rewrite both expect.
    "html_handling": "none"
  },

  // --------------------------------------------------------------------------
  // Cron Triggers — internal_hq.pb.js:2139 and :2642, unchanged strings.
  // src/cron.ts dispatches on event.cron, so the literal text here IS the
  // routing key. Changing it here without changing the switch silently stops
  // a job.
  //
  // THESE ARE UTC. PocketBase's cron ran in the container's timezone; "17 4"
  // may not be the same 04:17. Harmless for the prune (60-day cutoff),
  // NOT harmless for the sweep, which sends reminders. Confirm the Railway
  // container's TZ before cutover.
  // --------------------------------------------------------------------------
  // THE SWEEP TRIGGER IS DELIBERATELY OFF UNTIL CUTOVER.
  //
  // "*/5 * * * *" is the HQ sweep and it is now fully implemented — it really
  // does send. Production's PocketBase sweep is ALSO still running every five
  // minutes against its own database. Enabling both means the team gets every
  // reminder, nudge and digest TWICE, from two systems, with nothing on either
  // side saying why.
  //
  // Leaving it enabled but starving it of TWILIO_*/RESEND_API_KEY is not the
  // safe middle: the passes stamp their claim BEFORE they send, so a sweep
  // that cannot send still consumes remind_sent_at and followup_sent_at. Those
  // reminders would then never fire after cutover, silently. (Observed: one
  // manual run consumed 9 follow-up claims.)
  //
  // AT CUTOVER: add "*/5 * * * *" back HERE and remove PocketBase's in the
  // same change. Exactly one sweep may own a database.
  "triggers": {
    "crons": ["17 4 * * *"]
  },

  // --------------------------------------------------------------------------
  // SECRETS — names and locations only. Set with `wrangler secret put <NAME>`,
  // never in this file, and see migration/runbooks/SECRETS.md.
  //
  //   ANTICIPY_SERVICE_TOKEN   the god credential. guard.pb.js rung 0.
  //   ANTICIPY_AUTH_SECRET     server half of the owners JWT signature,
  //                            mixed with each record's own tokenKey.
  //   ANTICIPY_INTERNAL_KEY    every keyed HQ route (internal_hq.pb.js:48).
  //   ANTICIPY_VAULT_KEY_GCM   the RE-WRAPPED vault key.
  //                            migration/runbooks/reencrypt_vault.md — this
  //                            one is generated during cutover and the old
  //                            ANTICIPY_VAULT_KEY is deliberately NOT carried.
  //   GEMINI_API_KEY           /agent/llm, direct Gemini — the hook's name
  //                            (agent_key.pb.js:202) and the one SECRETS.md:298
  //                            puts on this Worker. GOOGLE_API_KEY is read as
  //                            an alias (SECRETS.md:94 rotates it under that
  //                            name). `wrangler secret list` on 2026-09-05
  //                            showed NEITHER bound: Google models then go
  //                            through OpenRouter, as the hook does.
  //   OPENROUTER_API_KEY       /agent/llm, every non-Google model, and Google
  //                            models while no Gemini key is bound.
  //   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER
  //                            the sweep's SMS and /sms/inbound's HMAC.
  //   SENDBLUE_WEBHOOK_SECRET  /sms/sendblue — the shared secret Sendblue sends
  //                            verbatim in its `sb-signing-secret` header. The
  //                            owner generates it, enters it in Sendblue's
  //                            dashboard (Developer → Webhooks, beside the URL
  //                            https://api.anticipy.ai/sms/sendblue) and puts
  //                            the same value here. Unset = 503, logged, never
  //                            a 403 that would look like a forged request.
  //
  //   SENDBLUE_API_KEY_ID / SENDBLUE_API_SECRET_KEY
  //                            outbound texts, src/messaging.ts (the sweep's
  //                            reminders and the password-reset code).
  //
  // /sms/sendblue AND src/messaging.ts ALSO READ ONE PLAIN VAR, not a secret,
  // and it is not set here yet: SENDBLUE_FROM_NUMBER — this deployment's
  // Sendblue number in E.164. Outbound texts name it as the sender; once it
  // is set, an inbound message addressed to any other number is refused
  // (403), as /sms/inbound refuses a To that is not TWILIO_PHONE_NUMBER. Add
  // it to `vars` when the number is known; unset, that inbound check is
  // skipped and messaging.ts does not choose Sendblue.
  //
  // /agent/llm ALSO READS TWO PLAIN VARS, not secrets, and neither is set here
  // yet: ANTICIPY_BROWSER_MODEL and ANTICIPY_VISION_MODEL — the only two models
  // a paired browser may spend through. Unset, src/llm.ts falls back to the
  // hook's defaults (anthropic/claude-sonnet-4.6, google/gemini-2.5-flash);
  // production PocketBase runs google/gemini-3.1-pro-preview
  // (research/evals/login-wall-2026-09-05/FINDINGS.md:26). Carry the Railway
  // values into `vars` at cutover; /agent/key (routes/agent.ts) has no default
  // and answers 503 until ANTICIPY_BROWSER_MODEL is set.
  //
  // LLM_PROVIDER_BASE is a TEST-ONLY var (scripts/llm_contract_local.sh) that
  // points /agent/llm at a loopback fake provider; src/llm.ts ignores any
  // non-loopback value. It must never appear in `vars` here.
  //
  // `vars` below holds only things that are NOT secret.
  // --------------------------------------------------------------------------
  "vars": {
    "ANTICIPY_ENV": "staging",
    // Railway redirects /r/{code} to www.anticipy.ai; the default in
    // fellowship.pb.js is the APEX. Leaving this unset sent every referral to
    // a different host than production does -- verified by diffing the two
    // Location headers. Not a secret, so it lives here where it is visible.
    "ANTICIPY_SITE_URL": "https://www.anticipy.ai",
    // The two models a paired browser may spend through (/agent/key hands the
    // first to the extension; /agent/llm allows exactly these). Carried from
    // the Railway values on 2026-09-05 at the hands' cutover; the browser model
    // is the one the 22-page wall golden set and the 512-token floor were
    // measured on. Not secrets.
    "ANTICIPY_BROWSER_MODEL": "google/gemini-3.1-pro-preview",
    "ANTICIPY_VISION_MODEL": "google/gemini-3.1-pro-preview"
  }
}
