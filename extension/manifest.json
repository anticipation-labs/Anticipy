{
  "manifest_version": 3,
  "name": "Anticipy",
  "version": "0.2.0",
  "description": "Anticipy's hands on your computer: executes tasks in your own logged-in browser.",
  "permissions": ["storage", "tabs", "tabGroups", "scripting", "alarms", "notifications", "debugger"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anticipy"
  }
}
