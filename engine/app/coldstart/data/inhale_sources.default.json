      "enabled": true,
      "priority": 2
    },
    {
      "id": "google_drive",
      "label": "Google Drive collaborators",
      "url": "https://drive.google.com/drive/recent",
      "scrape_selector": "[data-id]",
      "max_pages": 3,
      "enabled": true,
      "priority": 3
    }
  ],
