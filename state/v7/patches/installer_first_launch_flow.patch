@@ -0,0 +1,370 @@
+"""First-launch permission walkthrough backend.
+
+Routes (all loopback-only via the engine's existing perimeter):
+
+  GET  /api/permissions/status
+      Returns the current TCC status for every permission Anticipy needs.
+
+  POST /api/permissions/request/{kind}
+      Triggers the macOS native consent dialog for `kind` and returns
+      the new status. kind is one of:
+        microphone, accessibility, screen_recording, automation_<app>,
+        notifications.
+      automation_<app> takes one of: calendar, reminders, notes,
+      messages, system_events.
+
+  GET  /api/permissions/deeplink/{kind}
+      Returns the x-apple.systempreferences:// URL that opens the right
+      System Settings pane. The frontend opens it via window.open.
+
+  GET  /api/permissions/first_launch
+      Returns {"completed": bool, "marker_path": str} so the frontend
+      can decide whether to render the walkthrough.
+
+  POST /api/permissions/first_launch/complete
+      Body: {"skipped": bool, "snapshot": {...status dict...}}
+      Writes ~/.anticipy/v7/first_launch_complete.json so the modal
+      never re-shows. Honest: records the snapshot of what was actually
+      granted at completion time so subsequent launches can re-prompt
+      only for missing pieces.
+
+This module never touches frozen paths. It mirrors the deferred-import
+wire pattern in `app.product.native_action_wire` so importing at
+startup never wedges the FastAPI singleton. No em-dashes.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+from fastapi import APIRouter, HTTPException
+from fastapi.responses import JSONResponse
+from pydantic import BaseModel
+
+
+MARKER_DIR = Path(os.environ.get(
+    "ANTICIPY_V7_STATE_DIR",
+    str(Path.home() / ".anticipy" / "v7"),
+))
+MARKER_FILE = MARKER_DIR / "first_launch_complete.json"
+
+AUTOMATION_TARGETS = {
+    "calendar": "Calendar",
+    "reminders": "Reminders",
+    "notes": "Notes",
+    "messages": "Messages",
+    "system_events": "System Events",
+}
+
+DEEPLINKS = {
+    "microphone":
+        "x-apple.systempreferences:com.apple.preference.security?Privacy_Microphone",
+    "accessibility":
+        "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility",
+    "screen_recording":
+        "x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture",
+    "automation":
+        "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation",
+    "notifications":
+        "x-apple.systempreferences:com.apple.Notifications-Settings.extension",
+}
+
+
+router = APIRouter()
+
+
+# ---------------------------------------------------------------------------
+# status reads (no prompts)
+# ---------------------------------------------------------------------------
+
+def _mic_status() -> str:
+    if sys.platform != "darwin":
+        return "not_macos"
+    try:
+        from AVFoundation import AVCaptureDevice, AVMediaTypeAudio
+    except Exception:
+        return "unavailable"
+    names = {0: "not_determined", 1: "restricted", 2: "denied", 3: "authorized"}
+    try:
+        return names.get(int(AVCaptureDevice.authorizationStatusForMediaType_(
+            AVMediaTypeAudio)), "unknown")
+    except Exception:
+        return "unknown"
+
+
+def _accessibility_status() -> str:
+    if sys.platform != "darwin":
+        return "not_macos"
+    try:
+        from ApplicationServices import AXIsProcessTrusted
+    except Exception:
+        return "unavailable"
+    try:
+        return "authorized" if bool(AXIsProcessTrusted()) else "not_determined"
+    except Exception:
+        return "unknown"
+
+
+def _screen_recording_status() -> str:
+    if sys.platform != "darwin":
+        return "not_macos"
+    try:
+        from Quartz import CGPreflightScreenCaptureAccess
+        return "authorized" if bool(CGPreflightScreenCaptureAccess()) else "not_determined"
+    except Exception:
+        return "unknown"
+
+
+def _automation_status(target: str) -> str:
+    if sys.platform != "darwin":
+        return "not_macos"
+    app = AUTOMATION_TARGETS.get(target)
+    if not app:
+        return "unknown"
+    script = f'tell application "{app}" to count windows'
+    try:
+        r = subprocess.run(
+            ["/usr/bin/osascript", "-e", script],
+            capture_output=True, text=True, timeout=8.0, check=False,
+        )
+    except Exception:
+        return "unknown"
+    if r.returncode == 0:
+        return "authorized"
+    err = (r.stderr or "").strip()
+    if "-1743" in err or "Not authorized" in err:
+        return "denied"
+    return "not_determined"
+
+
+def _notifications_status() -> str:
+    if sys.platform != "darwin":
+        return "not_macos"
+    try:
+        from UserNotifications import UNUserNotificationCenter
+    except Exception:
+        return "unavailable"
+    centre = UNUserNotificationCenter.currentNotificationCenter()
+    done = threading.Event()
+    box: dict[str, Any] = {"status": "unknown"}
+
+    def cb(settings) -> None:
+        try:
+            box["status"] = {
+                0: "not_determined", 1: "denied",
+                2: "authorized", 3: "provisional", 4: "ephemeral",
+            }.get(int(settings.authorizationStatus()), "unknown")
+        finally:
+            done.set()
+    try:
+        centre.getNotificationSettingsWithCompletionHandler_(cb)
+    except Exception:
+        return "unknown"
+    done.wait(timeout=3.0)
+    return box["status"]
+
+
+def _full_status() -> dict[str, Any]:
+    return {
+        "microphone": _mic_status(),
+        "accessibility": _accessibility_status(),
+        "screen_recording": _screen_recording_status(),
+        "automation": {k: _automation_status(k) for k in AUTOMATION_TARGETS},
+        "notifications": _notifications_status(),
+    }
+
+
+# ---------------------------------------------------------------------------
+# prompt triggers
+# ---------------------------------------------------------------------------
+
+def _request_microphone(timeout_s: float = 12.0) -> str:
+    if sys.platform != "darwin":
+        return _mic_status()
+    try:
+        import Foundation
+        from AVFoundation import AVCaptureDevice, AVMediaTypeAudio
+    except Exception:
+        return _mic_status()
+    done = threading.Event()
+    out: dict[str, bool] = {"granted": False}
+
+    def cb(granted: bool) -> None:
+        out["granted"] = bool(granted)
+        done.set()
+    try:
+        AVCaptureDevice.requestAccessForMediaType_completionHandler_(
+            AVMediaTypeAudio, cb)
+    except Exception:
+        return _mic_status()
+    deadline = time.time() + timeout_s
+    while not done.is_set() and time.time() < deadline:
+        Foundation.NSRunLoop.currentRunLoop().runMode_beforeDate_(
+            Foundation.NSDefaultRunLoopMode,
+            Foundation.NSDate.dateWithTimeIntervalSinceNow_(0.1))
+    return _mic_status()
+
+
+def _request_accessibility() -> str:
+    if sys.platform != "darwin":
+        return _accessibility_status()
+    try:
+        from ApplicationServices import AXIsProcessTrustedWithOptions
+        from CoreFoundation import (
+            CFDictionaryCreate, kCFAllocatorDefault,
+            kCFTypeDictionaryKeyCallBacks, kCFTypeDictionaryValueCallBacks,
+            kCFBooleanTrue,
+        )
+        from ApplicationServices import kAXTrustedCheckOptionPrompt
+        opts = CFDictionaryCreate(
+            kCFAllocatorDefault,
+            [kAXTrustedCheckOptionPrompt], [kCFBooleanTrue], 1,
+            kCFTypeDictionaryKeyCallBacks, kCFTypeDictionaryValueCallBacks)
+        AXIsProcessTrustedWithOptions(opts)
+    except Exception:
+        pass
+    return _accessibility_status()
+
+
+def _request_screen_recording() -> str:
+    if sys.platform != "darwin":
+        return _screen_recording_status()
+    try:
+        from Quartz import CGRequestScreenCaptureAccess
+        CGRequestScreenCaptureAccess()
+    except Exception:
+        try:
+            subprocess.run(
+                ["/usr/sbin/screencapture", "-x", "-R", "0,0,1,1",
+                 str(MARKER_DIR / "screen_probe.png")],
+                capture_output=True, timeout=4.0, check=False,
+            )
+        except Exception:
+            pass
+    return _screen_recording_status()
+
+
+def _request_automation(target: str) -> str:
+    return _automation_status(target)  # the status read itself triggers the prompt
+
+
+def _request_notifications(timeout_s: float = 6.0) -> str:
+    if sys.platform != "darwin":
+        return _notifications_status()
+    try:
+        from UserNotifications import (
+            UNUserNotificationCenter,
+            UNAuthorizationOptionAlert, UNAuthorizationOptionSound,
+        )
+    except Exception:
+        return _notifications_status()
+    centre = UNUserNotificationCenter.currentNotificationCenter()
+    done = threading.Event()
+
+    def cb(granted: bool, err) -> None:
+        done.set()
+    try:
+        centre.requestAuthorizationWithOptions_completionHandler_(
+            UNAuthorizationOptionAlert | UNAuthorizationOptionSound, cb)
+    except Exception:
+        return _notifications_status()
+    done.wait(timeout=timeout_s)
+    return _notifications_status()
+
+
+# ---------------------------------------------------------------------------
+# routes
+# ---------------------------------------------------------------------------
+
+class CompleteBody(BaseModel):
+    skipped: bool = False
+    snapshot: dict[str, Any] = {}
+
+
+@router.get("/api/permissions/status")
+def status() -> JSONResponse:
+    return JSONResponse({"ok": True, "status": _full_status()})
+
+
+@router.post("/api/permissions/request/{kind}")
+def request_permission(kind: str) -> JSONResponse:
+    if kind == "microphone":
+        return JSONResponse({"ok": True, "kind": kind,
+                             "status": _request_microphone()})
+    if kind == "accessibility":
+        return JSONResponse({"ok": True, "kind": kind,
+                             "status": _request_accessibility()})
+    if kind == "screen_recording":
+        return JSONResponse({"ok": True, "kind": kind,
+                             "status": _request_screen_recording()})
+    if kind == "notifications":
+        return JSONResponse({"ok": True, "kind": kind,
+                             "status": _request_notifications()})
+    if kind.startswith("automation_"):
+        target = kind[len("automation_"):]
+        if target not in AUTOMATION_TARGETS:
+            raise HTTPException(status_code=400, detail=f"unknown automation target: {target}")
+        return JSONResponse({"ok": True, "kind": kind,
+                             "status": _request_automation(target)})
+    raise HTTPException(status_code=400, detail=f"unknown permission kind: {kind}")
+
+
+@router.get("/api/permissions/deeplink/{kind}")
+def deeplink(kind: str) -> JSONResponse:
+    url = DEEPLINKS.get(kind)
+    if not url:
+        raise HTTPException(status_code=404, detail=f"no deeplink for {kind}")
+    return JSONResponse({"ok": True, "kind": kind, "url": url})
+
+
+@router.get("/api/permissions/first_launch")
+def first_launch() -> JSONResponse:
+    completed = MARKER_FILE.exists()
+    payload: dict[str, Any] = {
+        "ok": True, "completed": completed,
+        "marker_path": str(MARKER_FILE),
+    }
+    if completed:
+        try:
+            payload["marker"] = json.loads(MARKER_FILE.read_text("utf-8"))
+        except Exception as e:
+            payload["marker_error"] = f"{type(e).__name__}: {e}"
+    return JSONResponse(payload)
+
+
+@router.post("/api/permissions/first_launch/complete")
+def first_launch_complete(body: CompleteBody) -> JSONResponse:
+    MARKER_DIR.mkdir(parents=True, exist_ok=True)
+    record = {
+        "completed_at": int(time.time()),
+        "skipped": bool(body.skipped),
+        "snapshot": body.snapshot or _full_status(),
+    }
+    MARKER_FILE.write_text(json.dumps(record, indent=2), "utf-8")
+    return JSONResponse({"ok": True, "marker_path": str(MARKER_FILE),
+                         "record": record})
+
+
+def attach() -> bool:
+    """Register the permission router on the existing FastAPI app.
+
+    Deferred-import wire pattern, mirrors `native_action_wire.attach`.
+    Returns True on success, False on any failure.
+    """
+    try:
+        from app.product.server import app
+        existing_paths = {getattr(r, "path", None) for r in app.routes}
+        new_paths = {getattr(r, "path", None) for r in router.routes}
+        if new_paths and new_paths.issubset(existing_paths):
+            return True
+        app.include_router(router)
+        return True
+    except Exception:
+        return False
