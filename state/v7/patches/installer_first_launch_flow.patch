@@ -0,0 +1,360 @@
+"use client";
+
+/**
+ * First-launch permission walkthrough modal.
+ *
+ * Rendered above the /app surface when
+ *   GET /api/permissions/first_launch -> {completed: false}
+ *
+ * Walks the user through five macOS permission grants in sequence:
+ *   1. Microphone        (NSMicrophoneUsageDescription)
+ *   2. Accessibility     (NSAccessibilityUsageDescription)
+ *   3. Screen recording  (NSScreenCaptureUsageDescription)
+ *   4. Automation        (NSAppleEventsUsageDescription, 5 sub-prompts)
+ *   5. Notifications     (NSUserNotificationsUsageDescription)
+ *
+ * For each step:
+ *   - Click "Grant" -> POST /api/permissions/request/<kind> (triggers TCC dialog)
+ *   - Status badge updates from /api/permissions/status
+ *   - If denied -> show remediation card with deep link to System Settings
+ *   - Once authorized -> auto-advance to next step
+ *
+ * When all five reach authorized OR user explicitly skips:
+ *   POST /api/permissions/first_launch/complete
+ *   Modal closes for good.
+ *
+ * No em-dashes. Under 300 lines.
+ */
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+
+const LOCAL_ENGINE = "http://127.0.0.1:8731";
+
+type PermStatus =
+  | "not_determined"
+  | "authorized"
+  | "denied"
+  | "restricted"
+  | "provisional"
+  | "ephemeral"
+  | "unavailable"
+  | "not_macos"
+  | "unknown";
+
+type AutomationTarget = "calendar" | "reminders" | "notes" | "messages" | "system_events";
+
+type FullStatus = {
+  microphone: PermStatus;
+  accessibility: PermStatus;
+  screen_recording: PermStatus;
+  automation: Record<AutomationTarget, PermStatus>;
+  notifications: PermStatus;
+};
+
+type StepKind =
+  | "microphone"
+  | "accessibility"
+  | "screen_recording"
+  | "automation"
+  | "notifications";
+
+type Step = {
+  kind: StepKind;
+  title: string;
+  rationale: string;
+  ctaLabel: string;
+};
+
+const STEPS: Step[] = [
+  {
+    kind: "microphone",
+    title: "So Anticipy can hear you.",
+    rationale:
+      "Microphone access lets Anticipy notice the to-dos you mention out loud.",
+    ctaLabel: "Grant microphone",
+  },
+  {
+    kind: "accessibility",
+    title: "So Anticipy can see what you're looking at.",
+    rationale:
+      "Accessibility lets Anticipy read the visible parts of native apps so it can act on what you reference.",
+    ctaLabel: "Grant accessibility",
+  },
+  {
+    kind: "screen_recording",
+    title: "For canvas apps like Figma.",
+    rationale:
+      "Screen recording lets Anticipy capture a frame only when the active app does not expose its text any other way.",
+    ctaLabel: "Grant screen recording",
+  },
+  {
+    kind: "automation",
+    title: "So Anticipy can use Calendar, Reminders, Notes, and Messages.",
+    rationale:
+      "macOS asks once per app. You'll see five quick dialogs in a row. Allow each one.",
+    ctaLabel: "Grant automation",
+  },
+  {
+    kind: "notifications",
+    title: "So Confirm Cards reach you in time.",
+    rationale:
+      "Notifications surface a quiet card a few seconds before any irreversible action so you can cancel without picking up your phone.",
+    ctaLabel: "Grant notifications",
+  },
+];
+
+const AUTOMATION_TARGETS: AutomationTarget[] = [
+  "calendar",
+  "reminders",
+  "notes",
+  "messages",
+  "system_events",
+];
+
+function badgeFor(status: PermStatus): { label: string; tone: "ok" | "warn" | "off" } {
+  if (status === "authorized") return { label: "granted", tone: "ok" };
+  if (status === "denied" || status === "restricted")
+    return { label: "blocked", tone: "warn" };
+  if (status === "not_macos" || status === "unavailable")
+    return { label: "not applicable", tone: "off" };
+  return { label: "pending", tone: "off" };
+}
+
+function isStepDone(kind: StepKind, status: FullStatus): boolean {
+  if (kind === "automation") {
+    return AUTOMATION_TARGETS.every((t) => status.automation[t] === "authorized");
+  }
+  const v = status[kind];
+  return v === "authorized";
+}
+
+function isStepBlocked(kind: StepKind, status: FullStatus): boolean {
+  if (kind === "automation") {
+    return AUTOMATION_TARGETS.some(
+      (t) => status.automation[t] === "denied" || status.automation[t] === "restricted",
+    );
+  }
+  const v = status[kind];
+  return v === "denied" || v === "restricted";
+}
+
+async function pollStatus(): Promise<FullStatus | null> {
+  try {
+    const r = await fetch(`${LOCAL_ENGINE}/api/permissions/status`, {
+      method: "GET",
+      cache: "no-store",
+    });
+    if (!r.ok) return null;
+    const body = await r.json();
+    return body?.status ?? null;
+  } catch {
+    return null;
+  }
+}
+
+async function triggerRequest(kind: string): Promise<PermStatus | null> {
+  try {
+    const r = await fetch(`${LOCAL_ENGINE}/api/permissions/request/${kind}`, {
+      method: "POST",
+    });
+    if (!r.ok) return null;
+    const body = await r.json();
+    return (body?.status as PermStatus) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+async function openSystemSettings(kind: string): Promise<void> {
+  try {
+    const r = await fetch(`${LOCAL_ENGINE}/api/permissions/deeplink/${kind}`);
+    if (!r.ok) return;
+    const body = await r.json();
+    if (body?.url) window.open(body.url, "_self");
+  } catch {
+    /* honest no-op */
+  }
+}
+
+async function markComplete(skipped: boolean, snapshot: FullStatus | null): Promise<void> {
+  try {
+    await fetch(`${LOCAL_ENGINE}/api/permissions/first_launch/complete`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ skipped, snapshot: snapshot ?? {} }),
+    });
+  } catch {
+    /* honest no-op; next launch re-shows */
+  }
+}
+
+export function PermissionWalkthrough({ onClose }: { onClose: () => void }) {
+  const [stepIdx, setStepIdx] = useState(0);
+  const [status, setStatus] = useState<FullStatus | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const refresh = useCallback(async () => {
+    const next = await pollStatus();
+    if (next) setStatus(next);
+  }, []);
+
+  useEffect(() => {
+    refresh();
+    const id = setInterval(refresh, 2000);
+    return () => clearInterval(id);
+  }, [refresh]);
+
+  const step = STEPS[stepIdx];
+
+  const advance = useCallback(() => {
+    if (stepIdx < STEPS.length - 1) setStepIdx((i) => i + 1);
+  }, [stepIdx]);
+
+  useEffect(() => {
+    if (!status || !step) return;
+    if (isStepDone(step.kind, status)) advance();
+  }, [status, step, advance]);
+
+  const allDone = useMemo(() => {
+    if (!status) return false;
+    return STEPS.every((s) => isStepDone(s.kind, status));
+  }, [status]);
+
+  const handleGrant = useCallback(async () => {
+    if (!step) return;
+    setBusy(true);
+    try {
+      if (step.kind === "automation") {
+        for (const t of AUTOMATION_TARGETS) {
+          await triggerRequest(`automation_${t}`);
+        }
+      } else {
+        await triggerRequest(step.kind);
+      }
+      await refresh();
+    } finally {
+      setBusy(false);
+    }
+  }, [step, refresh]);
+
+  const handleSkipStep = useCallback(() => advance(), [advance]);
+
+  const handleFinish = useCallback(async (skipped: boolean) => {
+    await markComplete(skipped, status);
+    onClose();
+  }, [status, onClose]);
+
+  if (!step) return null;
+
+  const blocked = status ? isStepBlocked(step.kind, status) : false;
+
+  return (
+    <div
+      role="dialog"
+      aria-modal="true"
+      className="fixed inset-0 z-50 grid place-items-center bg-dark/85 backdrop-blur-md p-6"
+    >
+      <div className="w-full max-w-2xl rounded-3xl border border-cream/10 bg-dark/95 p-10 shadow-2xl">
+        {allDone ? (
+          <section>
+            <h2 className="font-serif text-3xl text-cream">You're all set.</h2>
+            <p className="mt-4 text-cream/70">
+              Anticipy is listening. Talk normally. We'll surface a Confirm Card
+              before anything irreversible.
+            </p>
+            <button
+              onClick={() => handleFinish(false)}
+              className="mt-8 rounded-pill bg-cream px-6 py-3 text-dark hover:bg-gold"
+            >
+              Take me in
+            </button>
+          </section>
+        ) : (
+          <section>
+            <p className="text-[11px] uppercase tracking-[0.22em] text-gold/80">
+              Step {stepIdx + 1} of {STEPS.length}
+            </p>
+            <h2 className="mt-3 font-serif text-3xl text-cream">{step.title}</h2>
+            <p className="mt-4 text-cream/70">{step.rationale}</p>
+
+            <div className="mt-6 grid grid-cols-1 gap-2 rounded-2xl border border-cream/10 p-4 text-sm">
+              {STEPS.map((s) => {
+                const b = status ? badgeFor(
+                  s.kind === "automation"
+                    ? (isStepDone("automation", status)
+                        ? "authorized"
+                        : isStepBlocked("automation", status)
+                          ? "denied"
+                          : "not_determined")
+                    : status[s.kind],
+                ) : { label: "pending", tone: "off" as const };
+                const tone = b.tone === "ok"
+                  ? "text-emerald-300"
+                  : b.tone === "warn" ? "text-amber-300" : "text-cream/40";
+                return (
+                  <div key={s.kind} className="flex items-center justify-between">
+                    <span className="text-cream/80">{s.title.split(".")[0]}.</span>
+                    <span className={`uppercase tracking-wide text-xs ${tone}`}>
+                      {b.label}
+                    </span>
+                  </div>
+                );
+              })}
+            </div>
+
+            <div className="mt-8 flex flex-wrap gap-3">
+              <button
+                onClick={handleGrant}
+                disabled={busy}
+                className="rounded-pill bg-cream px-6 py-3 text-dark hover:bg-gold disabled:opacity-50"
+              >
+                {busy ? "Asking macOS..." : step.ctaLabel}
+              </button>
+              {blocked && (
+                <button
+                  onClick={() => openSystemSettings(step.kind)}
+                  className="rounded-pill border border-cream/30 px-6 py-3 text-cream/90 hover:border-gold"
+                >
+                  Open System Settings
+                </button>
+              )}
+              <button
+                onClick={handleSkipStep}
+                className="rounded-pill px-6 py-3 text-cream/60 hover:text-cream"
+              >
+                Skip for now
+              </button>
+            </div>
+
+            {blocked && (
+              <p className="mt-4 text-xs text-amber-300/90">
+                macOS says this is blocked. Open System Settings, toggle Anticipy
+                on, then come back and click {step.ctaLabel.toLowerCase()} again.
+              </p>
+            )}
+
+            <button
+              onClick={() => handleFinish(true)}
+              className="mt-6 text-xs uppercase tracking-[0.18em] text-cream/40 hover:text-cream/70"
+            >
+              Skip the rest, I'll handle it later
+            </button>
+          </section>
+        )}
+      </div>
+    </div>
+  );
+}
+
+export async function shouldShowWalkthrough(): Promise<boolean> {
+  try {
+    const r = await fetch(`${LOCAL_ENGINE}/api/permissions/first_launch`, {
+      cache: "no-store",
+    });
+    if (!r.ok) return false;
+    const body = await r.json();
+    return body?.completed === false;
+  } catch {
+    return false;
+  }
+}
