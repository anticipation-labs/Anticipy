+def active_snapshot_scoped(account_id: str, device_id: str) -> list[dict]:
+    """Scoped snapshot. Reads the per-(account, device) partition;
+    when no scoped data has been written yet, falls back to the legacy
+    `anticipy-user` partition so the first run is not empty.
+    """
+    user_id = _scoped_user_id(account_id, device_id)
+    snap = [e.to_dict() for e in _load(user_id) if e.active]
+    if snap:
+        return snap
+    legacy = [e.to_dict() for e in _load("anticipy-user") if e.active]
+    return legacy
+
+
+def read_scoped(account_id: str, device_id: str,
+                kind: str | None = None) -> list[dict]:
+    """Verifier-targeted scoped read. Returns active entries filtered
+    by (account, device) (and optionally `kind`). Cross-account leaks
+    are impossible here because the partition itself is keyed by both
+    ids.
+    """
+    items = active_snapshot_scoped(account_id, device_id)
+    if kind:
+        items = [it for it in items if it.get("kind") == kind]
+    return items
+
+
+def write_scoped(account_id: str, device_id: str, kind: str, key: str,
+                 value: str, source: str = "engine",
+                 provenance: str = "engine_write",
+                 confidence: float = 1.0,
+                 evidence: str = "") -> dict:
+    """Verifier-targeted scoped write. Append a fully-scoped entry to
+    the per-(account, device) partition. Returns the persisted row.
+    """
+    user_id = _scoped_user_id(account_id, device_id)
+    entry = MemoryEntry(
+        mem_id=f"w-{int(time.time()*1000)}-{(hash(value) & 0xFFFF):04x}",
+        kind=kind, key=(key or value)[:80], value=value,
+        evidence=evidence or value, ts=time.time(), active=True,
+        account_id=account_id or LEGACY_ACCOUNT_ID,
+        device_id=device_id, source=source,
+        confidence=float(confidence), provenance=provenance,
+    )
+    with _lock:
+        entries = _load(user_id)
+        entries.append(entry)
+        _save(user_id, entries)
+    return entry.to_dict()
+
+
+def delete_scoped_matching(account_id: str, device_id: str,
+                            contains: str) -> int:
+    """Verifier-targeted cleanup. Deactivate every entry under
+    (account, device) whose value contains the substring. Returns the
+    count deactivated.
+    """
+    needle = (contains or "").strip()
+    if not needle:
+        return 0
+    user_id = _scoped_user_id(account_id, device_id)
+    n = 0
+    with _lock:
+        entries = _load(user_id)
+        for e in entries:
+            if e.active and needle in (e.value or ""):
+                e.active = False
+                n += 1
+        if n:
+            _save(user_id, entries)
+    return n
+
