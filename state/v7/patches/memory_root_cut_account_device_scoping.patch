+# V7 cut: per-(account, device) scoping sentinel. The legacy single
+# tenant partition lived under "anticipy-user"; rows that pre-date the
+# cut are tagged with LEGACY_ACCOUNT_ID on read so the verifier's
+# required-fields check still passes.
+LEGACY_ACCOUNT_ID = "legacy-anticipy-user-1"
+
+
+def _scoped_user_id(account_id: str, device_id: str) -> str:
+    """Compose a per-(account, device) partition id under the existing
+    `user_data_dir(...)` scheme. Keeping the partition function stable
+    avoids touching the frozen platform adapter; we only change the
+    *name* we hand it. Empty account/device fall back to the V7 legacy
+    sentinel so pre-cut JSONL data is not orphaned.
+    """
+    a = (account_id or "").strip() or LEGACY_ACCOUNT_ID
+    d = (device_id or "").strip()
+    safe_a = "".join(c for c in a if c.isalnum() or c in ("-", "_")) or "legacy"
+    safe_d = "".join(c for c in d if c.isalnum() or c in ("-", "_"))
+    if not safe_d:
+        return safe_a
+    return f"{safe_a}--{safe_d}"
+
