+def _install_identity_path() -> Path:
+    p = Path(os.path.expanduser("~/.anticipy/v7/install_identity.json"))
+    p.parent.mkdir(parents=True, exist_ok=True)
+    return p
+
+
+def _get_install_identity() -> dict:
+    """Per-install (account_id, device_id) pair. Persisted under
+    ~/.anticipy/v7/install_identity.json so it survives restarts.
+    On first call the file is minted; thereafter it is read.
+    """
+    p = _install_identity_path()
+    if p.exists():
+        try:
+            data = json.loads(p.read_text(encoding="utf-8"))
+            if isinstance(data, dict) and data.get("account_id") \
+                    and data.get("device_id"):
+                return {"account_id": str(data["account_id"]),
+                        "device_id": str(data["device_id"])}
+        except Exception:
+            pass
+    minted = {"account_id": f"install-{uuid.uuid4().hex[:12]}",
+              "device_id": f"device-{uuid.uuid4().hex[:8]}"}
+    try:
+        p.write_text(json.dumps(minted, indent=2), encoding="utf-8")
+    except Exception:
+        pass
+    return minted
+
+
+def _get_active_account_device(request: "Request | None" = None,
+                                override: dict | None = None) -> tuple[str, str]:
+    """Resolve (account_id, device_id) for the current call. Order:
+    1) explicit override dict (used by the mp3 eval block to swap to a
+       one-shot scope), 2) request headers if present, 3) the swapped
+       USER_ID global when it has the scoped `<acct>--<dev>` shape
+       (set by `/api/listen/inject` and the mp3 eval), 4) persisted
+       install identity. The legacy sentinel is never returned from
+       here; legacy callers without a request get the install identity.
+    """
+    if override and override.get("account_id") and override.get("device_id"):
+        return (str(override["account_id"]), str(override["device_id"]))
+    if request is not None:
+        try:
+            hdr_a = request.headers.get("x-anticipy-account-id", "").strip()
+            hdr_d = request.headers.get("x-anticipy-device-id", "").strip()
+            if hdr_a and hdr_d:
+                return (hdr_a, hdr_d)
+        except Exception:
+            pass
+    swapped = (USER_ID or "").strip()
+    if "--" in swapped and swapped != _LEGACY_USER_ID:
+        acct, dev = swapped.split("--", 1)
+        if acct and dev:
+            return (acct, dev)
+    identity = _get_install_identity()
+    return (identity["account_id"], identity["device_id"])
 
 
