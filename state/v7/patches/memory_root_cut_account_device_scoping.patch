+                          device_id: str = "",
+                          kind: str | None = None) -> JSONResponse:
+    """V7 scoped read: returns rows filtered by (account, device).
+    Falls back to the resolved active scope when the query string omits
+    both ids (rare for a verifier but useful for the desktop UI).
+    """
+    from app.anticipy import memory as MEM
+    if not account_id or not device_id:
+        account_id, device_id = _get_active_account_device(request)
+    items = MEM.read_scoped(account_id, device_id, kind=kind)
+    return JSONResponse({"items": items, "account_id": account_id,
+                         "device_id": device_id})
 
 
+@app.post("/api/memory/delete")
+def memory_delete_endpoint(body: MemoryDeleteBody,
