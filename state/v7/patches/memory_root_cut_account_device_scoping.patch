+@app.post("/api/memory/write")
+def memory_write_endpoint(body: MemoryWriteBody,
+                           request: Request) -> JSONResponse:
+    """V7 scoped write: account_id+device_id are mandatory in the body
+    so a verifier can probe arbitrary accounts. Request headers are
+    ignored on writes to keep the payload self-describing.
+    """
+    from app.anticipy import memory as MEM
+    try:
+        row = MEM.write_scoped(body.account_id, body.device_id,
+                                kind=body.kind, key=body.key,
+                                value=body.value, source=body.source,
+                                provenance=body.provenance,
+                                confidence=body.confidence)
+        return JSONResponse({"ok": True, "entry": row})
+    except Exception as e:
+        return JSONResponse({"ok": False,
+                             "error": f"{type(e).__name__}: {e}"},
+                            status_code=500)
