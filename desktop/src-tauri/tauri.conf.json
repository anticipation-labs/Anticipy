{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anticipy",
  "mainBinaryName": "Anticipy",
  "version": "1.0.0",
  "identifier": "ai.anticipy.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["anticipy"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/tray.png": "icons/tray.png",
      "icons/tray@2x.png": "icons/tray@2x.png",
      "resources/parakeet-tdt-0.6b-v3/config.json": "parakeet-tdt-0.6b-v3/config.json",
      "resources/parakeet-tdt-0.6b-v3/model.safetensors": "parakeet-tdt-0.6b-v3/model.safetensors",
      "resources/parakeet-tdt-0.6b-v3/tokenizer.model": "parakeet-tdt-0.6b-v3/tokenizer.model",
      "resources/parakeet-tdt-0.6b-v3/tokenizer.vocab": "parakeet-tdt-0.6b-v3/tokenizer.vocab",
      "resources/parakeet-tdt-0.6b-v3/vocab.txt": "parakeet-tdt-0.6b-v3/vocab.txt"
    },
    "externalBin": ["bin/anticipy-engine"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
