{"id": "tep-0065", "text": "The ethics approval on the freezer samples only covers the old protocol, I never amended it.", "gold": "act", "event_id": "u612gielhrs7ti7", "decision": "act", "goal": "amend ethics approval for freezer samples", "addressee": "self", "segment": "4g36tefwjeasnb3", "elapsed_s": 12.2, "capture_started_at": "2026-08-21T19:57:32.453Z", "pushed_at": "2026-08-21T19:49:02.006Z", "said": [{"text": "i have the draft amendment for the ethics approval for the freezer samples, based on the old protocol; ready to go when you give the word.", "goal": "amend ethics approval for freezer samples", "decision": "act"}], "jobs": [{"id": "389gypxas06vgd7", "status": "awaiting_confirm", "lane": "", "goal": "amend ethics approval for freezer samples"}]}
{"id": "tep-0081", "text": "My breathing apparatus competency is due for reassessment and the slots go in about a day.", "gold": "act", "event_id": "s0kkkzrifefxl0w", "decision": "act", "goal": "book breathing apparatus competency reassessment", "addressee": "self", "segment": "t0o4rpjn0f58yqa", "elapsed_s": 28.8, "capture_started_at": "2026-08-21T19:58:22.453Z", "pushed_at": "2026-08-21T19:49:15.009Z", "said": [{"text": "for the breathing apparatus reassessment, i'm seeing an open slot at the coal harbour location, if that works. what time would be best for you?", "goal": "book breathing apparatus competency reassessment", "decision": "act"}], "jobs": [{"id": "sve2h5yfe9uju10", "status": "awaiting_confirm", "lane": "", "goal": "book breathing apparatus competency reassessment"}]}
