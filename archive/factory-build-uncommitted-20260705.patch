+  color: #ffb1a6;
+}
+
+.pz-button-xl {
+  min-height: 54px;
+  padding-inline: 28px;
+}
+
+.pz-pendant {
+  position: relative;
+  min-height: 380px;
+  display: grid;
+  place-items: center;
+}
+
+.pz-pendant-chain {
+  position: absolute;
+  top: -70px;
+  width: 2px;
+  height: 190px;
+  background: linear-gradient(180deg, transparent, rgba(248, 244, 236, 0.72));
+  transform: rotate(18deg);
+  transform-origin: bottom;
+  opacity: 0.68;
+}
+
+.pz-pendant-body {
+  width: 86px;
+  height: 156px;
+  border-radius: 44px;
+  background:
+    radial-gradient(circle at 62% 42%, rgba(255, 239, 180, 0.95), transparent 4px),
+    linear-gradient(90deg, #2b2a27, #b8b0a1 44%, #3c3933);
+  box-shadow: 0 40px 90px rgba(0, 0, 0, 0.56), 0 0 60px rgba(215, 179, 106, 0.16);
+  animation: pzFloat 4s ease-in-out infinite;
+  z-index: 2;
+}
+
+.pz-pendant-ring {
+  position: absolute;
+  width: 230px;
+  height: 230px;
+  border: 1px solid rgba(215, 179, 106, 0.18);
+  border-radius: 50%;
+  animation: pzRing 3.8s ease-out infinite;
+}
+
+.pz-pendant-ring.two {
+  animation-delay: 1.2s;
+}
+
+.pz-action-dock {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 10px;
+}
+
+.pz-action-tile {
+  min-height: 92px;
+  padding: 18px;
+  border: 1px solid var(--pz-line);
