+/* Phase Zero V2: consumer app surface */
+:root {
+  --pz-bg: #080807;
+  --pz-bg-soft: #10100e;
+  --pz-surface: rgba(245, 242, 235, 0.08);
+  --pz-surface-strong: rgba(245, 242, 235, 0.13);
+  --pz-cream: #f8f4ec;
+  --pz-cream-soft: rgba(248, 244, 236, 0.68);
+  --pz-muted: rgba(248, 244, 236, 0.48);
+  --pz-line: rgba(248, 244, 236, 0.14);
+  --pz-line-strong: rgba(248, 244, 236, 0.24);
+  --pz-gold: #d7b36a;
+  --pz-good: #53c391;
+  --pz-red: #d65b4a;
+}
+
+body {
+  background: var(--pz-bg);
+}
+
+.pz {
+  min-height: 100vh;
+  display: block;
+  color: var(--pz-cream);
+  background:
+    radial-gradient(circle at 50% 18%, rgba(215, 179, 106, 0.12), transparent 28rem),
+    radial-gradient(circle at 72% 34%, rgba(255, 255, 255, 0.05), transparent 22rem),
+    linear-gradient(180deg, #050505 0%, var(--pz-bg) 48%, #0c0b09 100%);
+}
+
+.pz-appbar {
+  height: 76px;
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  padding: 0 clamp(18px, 4vw, 48px);
+  border-bottom: 1px solid rgba(248, 244, 236, 0.08);
+}
+
+.pz-brand {
+  color: var(--pz-cream);
+}
+
+.pz-brand span {
+  width: 36px;
+  height: 36px;
+  background: var(--pz-cream);
+  color: var(--pz-bg);
+  box-shadow: 0 0 32px rgba(248, 244, 236, 0.12);
+}
+
+.pz-brand strong {
+  color: var(--pz-cream);
+  font-size: 24px;
+}
+
+.pz-appbar-center {
+  display: inline-flex;
+  align-items: center;
+  gap: 9px;
+  color: var(--pz-muted);
+  font-size: 13px;
+  font-weight: 600;
+}
+
+.pz-dot {
+  background: rgba(248, 244, 236, 0.28);
+}
+
+.pz-dot.ok {
+  background: var(--pz-good);
+  box-shadow: 0 0 16px rgba(83, 195, 145, 0.36);
+}
+
+.pz-menu-button {
+  justify-self: end;
+  width: 48px;
+  height: 48px;
+  border: 1px solid var(--pz-line);
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  gap: 4px;
+  background: rgba(248, 244, 236, 0.08);
+}
+
+.pz-menu-button span {
+  width: 18px;
+  height: 2px;
+  border-radius: 999px;
+  background: var(--pz-cream);
+}
+
+.pz-drawer {
+  position: fixed;
+  inset: 0;
+  z-index: 80;
+}
+
+.pz-drawer-backdrop {
+  position: absolute;
+  inset: 0;
+  background: rgba(0, 0, 0, 0.6);
+}
+
+.pz-drawer-panel {
+  position: absolute;
+  top: 14px;
+  right: 14px;
+  width: min(360px, calc(100vw - 28px));
+  padding: 18px;
+  border: 1px solid var(--pz-line);
+  border-radius: 8px;
+  background: rgba(18, 18, 16, 0.96);
+  box-shadow: 0 28px 100px rgba(0, 0, 0, 0.48);
+  backdrop-filter: blur(20px);
+  display: grid;
+  gap: 8px;
+  animation: pzSlideIn 220ms ease-out;
+}
+
+.pz-drawer-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 8px;
+}
+
+.pz-drawer-head button {
+  color: var(--pz-muted);
+  background: transparent;
+}
+
+.pz-drawer-panel a {
+  min-height: 58px;
+  padding: 10px 12px;
+  border-radius: 8px;
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  text-decoration: none;
+  color: var(--pz-cream-soft);
+}
+
+.pz-drawer-panel a.active,
+.pz-drawer-panel a:hover {
+  background: rgba(248, 244, 236, 0.1);
