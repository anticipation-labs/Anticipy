+.pz-hero,
+.pz-stage-hero,
+.pz-listen,
+.pz-source-strip,
+.pz-panel,
+.pz-task,
+.pz-featured-task {
+  border: 1px solid var(--pz-line);
+  border-radius: 8px;
+  background: var(--pz-surface);
+  box-shadow: 0 18px 80px rgba(0, 0, 0, 0.24);
+}
+
+.pz-hero {
+  min-height: min(610px, calc(100vh - 210px));
+  padding: clamp(26px, 6vw, 70px);
