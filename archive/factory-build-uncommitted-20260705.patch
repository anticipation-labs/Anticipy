+
+.pz-scene {
+  display: grid;
+  gap: 16px;
+  animation: pzRise 420ms ease-out both;
+}
+
+.pz-board-scene {
+  grid-template-columns: minmax(0, 1fr) minmax(320px, 0.62fr);
+  align-items: start;
+}
+
+.pz-board-scene .pz-listen {
+  grid-column: 1 / -1;
+}
+
+.pz-board-scene .pz-featured-task {
+  grid-row: span 2;
+}
