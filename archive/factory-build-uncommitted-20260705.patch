+.pz-hero-copy h2,
+.pz-stage-hero h2,
+.pz-listen h2 {
+  color: var(--pz-cream);
+  letter-spacing: 0;
+}
+
+.pz-hero-copy h2 {
+  max-width: 780px;
+  font-size: clamp(44px, 7vw, 84px);
