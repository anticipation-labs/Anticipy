# Anticipy-executor-working — environment variable template
# Copy to .env.local and fill in real values. .env.local is gitignored.
# This file contains NO secrets and is safe to commit.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hot-path LLMs
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Offline-batch
DEEPSEEK_API_KEY=

# Additional providers
GROQ_API_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=

# CAPTCHA solving
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=

# Email (Resend)
RESEND_API_KEY=

# Twilio (set TWILIO_MOCK=false for live SMS/voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MOCK=false

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Browser / Proxy
STEEL_API_KEY=
STEEL_API_URL=https://api.steel.dev
SCRAPERAPI_KEY=
HETZNER_API_TOKEN=

# Security (server-side)
ENCRYPTION_KEY=
JWT_SECRET=
PROFILE_ENCRYPTION_KEY=
# Shared HMAC secret the web app + engine use to sign/verify per-user browser pairing codes (B12).
ENGINE_INTERNAL_TOKEN=
SECRET_KEY=
# B12 — signed per-user browser pairing. OFF by default: the extension keeps today's single-owner
# /ws/token behavior. Set to 1 ONLY on a shared cloud engine (needs ENGINE_INTERNAL_TOKEN set), where
# each signed-in user's hand must bind to THEIR core via a signed /ws/pair claim, not the owner's.
ANTICIPY_PER_USER_HANDS=

# App
ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=
DEMO_PASSCODE=
PORT=8000
TEST_USER_PHONE=
TEST_USER_EMAIL=
GMAIL_TEST_PASSWORD=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Stripe (pre-orders)
STRIPE_PREORDER_PRODUCT_ID=
STRIPE_PREORDER_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio routing / notify targets
OWNER_PHONE=
TWILIO_TEST_TO_REAL_NUMBER_E164=
TWILIO_NOTIFY_TO=
TWILIO_TEST_TO_REAL_NUMBER=0
